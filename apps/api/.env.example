# Server
PORT=3001
NODE_ENV=development

# MongoDB Atlas (replace with your cluster URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES_IN=365d
JWT_REFRESH_EXPIRES_IN=365d

# CORS (Next.js dev)
CORS_ORIGIN=http://localhost:3000

# Outgoing email (Gmail SMTP) — used for the "forgot password" reset code.
# Without SMTP_USER/SMTP_PASS, the code is only logged (dev fallback), never actually emailed.
# SMTP_PASS is a Gmail App Password, not your account password:
# Google Account -> Security -> 2-Step Verification (must be ON) -> App passwords -> generate for "Mail".
SMTP_USER=youraddress@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# PDF → Word OCR (optional)
# OCR_MAX_FILE_MB=15
# OCR_LANGUAGES=eng+ben
# OCR_MIN_TEXT_CHARS=40

# Seed super admin (used by seed script only)
SEED_ADMIN_EMAIL=admin@ibas.gov.bd
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME_EN=System Administrator
# Optional Bengali name at data entry
# SEED_ADMIN_NAME_BN=

# Agora.io (LIVE_STREAM one-to-many). Required for join tokens.
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
# AGORA_USE_TOKEN=false   # only if App Certificate is DISABLED in Agora Console
