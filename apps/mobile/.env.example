# API base URL (include /api/v1)
# Android emulator: http://10.0.2.2:3001/api/v1
# iOS simulator:    http://localhost:3001/api/v1
# Physical device:  http://<your-pc-lan-ip>:3001/api/v1
# Remote (Render):  https://ibas-api.onrender.com/api/v1
EXPO_PUBLIC_API_URL=https://ibas-api.onrender.com/api/v1

# Request timeout in ms (default 90000 — helps with cold starts on remote API)
EXPO_PUBLIC_API_TIMEOUT_MS=90000

# Web origin for static-ref pages (Next.js public /static-ref/...)
# Local:  http://<pc-lan-ip>:3000
# Remote: https://ibas-web.onrender.com
EXPO_PUBLIC_WEB_URL=https://ibas-web.onrender.com
