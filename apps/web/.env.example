# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web sign-up is hidden unless this is "true" (read at build time; redeploy after changing)
NEXT_PUBLIC_WEB_REGISTRATION_OPEN=false

# Express API (server-side proxy — required on Render web service)
# Local dev:
API_URL=http://127.0.0.1:3001
# Render production (example):
# API_URL=https://your-api-service.onrender.com