{
  "expo": {
    "name": "ProAssist",
    "slug": "ibas-learn",
    "version": "1.0.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "ibaslearn",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.bd.ibas.learn",
      "infoPlist": {
        "NSCameraUsageDescription": "ProAssist uses the camera for live classes.",
        "NSMicrophoneUsageDescription": "ProAssist uses the microphone for live classes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2B52"
      },
      "package": "gov.bd.ibas.learn",
      "versionCode": 30,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "591b2377-7e29-480a-ba95-472dba9adb95"
      }
    },
    "owner": "rashedunnabi"
  }
}
